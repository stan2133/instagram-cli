{
  "name": "instagram-cli",
  "version": "1.0.0",
  "description": "Instagram CLI tool with two-phase architecture (login + operations)",
  "main": "dist/index.js",
  "bin": {
    "insta": "./bin/insta.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "dev": "ts-node src/index.ts",
    "login": "node bin/insta.js login",
    "qr:monitor": "node qr-monitor-server.js",
    "mcp:qr": "node qr-monitor-mcp-server.js",
    "mcp:daemon": "node ig-daemon-mcp-server.js",
    "server": "node src/server.js",
    "dev:server": "node --watch src/server.js",
    "daemon:start": "node daemon/server.js",
    "security:scan": "bash scripts/secret-scan.sh --tracked",
    "security:scan:staged": "bash scripts/secret-scan.sh --staged",
    "security:install-hooks": "bash scripts/install-git-hooks.sh"
  },
  "keywords": [
    "instagram",
    "cli",
    "social-media",
    "instagram-cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/puppeteer": "^5.4.7",
    "axios": "^1.13.5",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "figlet": "^1.7.0",
    "form-data": "^4.0.5",
    "inquirer": "^9.2.0",
    "instagram-private-api": "^1.46.1",
    "node-fetch": "^3.3.2",
    "ora": "^8.0.0",
    "puppeteer": "^24.37.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/figlet": "^1.5.0",
    "@types/form-data": "^2.2.1",
    "@types/inquirer": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/sharp": "^0.31.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
