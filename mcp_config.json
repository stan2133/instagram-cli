{
  "mcpServers": {
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "puppeteer-mcp-server"],
      "env": {
        "DEBUG_PORT": "9222"
      }
    },
    "qrMonitor": {
      "command": "node",
      "args": ["qr-monitor-mcp-server.js"]
    },
    "igDaemon": {
      "command": "node",
      "args": ["ig-daemon-mcp-server.js"]
    }
  }
}
