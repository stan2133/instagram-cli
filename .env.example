# Instagram API Configuration
API_MODE=private
API_TIMEOUT=30000
API_RETRIES=3

# Instagram Credentials (optional, not recommended for security)
# INSTAGRAM_USERNAME=your_username
# INSTAGRAM_PASSWORD=your_password

# Session Configuration
SESSION_DIR=~/.instagram-cli/sessions
SESSION_DEFAULT_ACCOUNT=default
SESSION_ENCRYPTION_ENABLED=true
SESSION_AUTO_REFRESH=true

# Log Configuration
LOG_LEVEL=info
LOG_FILE=~/.instagram-cli/logs/app.log

# Upload Configuration
MAX_PHOTO_SIZE=10485760
MAX_VIDEO_SIZE=52428800

# Display Configuration
COLOR_ENABLED=true
DATE_FORMAT=YYYY-MM-DD HH:mm:ss
